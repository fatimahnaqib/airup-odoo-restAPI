<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_view_location_inherited_airup_form" model="ir.ui.view">
        <field name="name">stock.view.location.inherited.airup.form</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
                <xpath expr="//field[@name='return_location']"  position="after">
                    <field name="shelf_location"/>
                </xpath>
                <xpath expr="//group[@name='additional_info']"  position="after">
                    <group string="Shelf Location Information" name="shelf_info" attrs="{'invisible':[('shelf_location', '=', False)]}" >
                        <field name="row"/>
                        <field name="bay"/>
                        <field name="height"/>
                        <field name="width"/>
                        <field name="depth"/>
                    </group>
                </xpath>
        </field>
    </record>
</odoo>